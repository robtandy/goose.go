var grid: u8[5000] = [0; 5000];
var marks: bool[4200] = [true; 4200];

fn checksum(s: const u64[:]) -> u64 {
    var h: u64 = 0;
    for x in s { h = h * 31 + x; }
    h
}

fn main() {
    grid[10] = 3;
    grid[4999] = grid[10] + 4;
    var lit = 0;
    for i in 0..marks.len { if marks[i] && i % 1000 == 0 { lit += 1; } }
    marks[0] = false;
    print(grid[10], " ", grid[4999], " ", grid.len, " ", TABLE[519], " ", TABLE.len, " ", lit, " ", marks[0]);
    print(checksum(TABLE), " ", checksum(TABLE[500..]), " ", TABLE[3..6]);
    var n = 0;
    for b in grid { n += b; }
    print(n);
}
