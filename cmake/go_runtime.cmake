# Embeds the Go runtime's source in the compiler (issue #19): writes OUT, a
# C++ header holding the text of each of FILES (a comma-separated list of
# names in DIR, runtime/go), as go_runtime_files (src/codegen_go_runtime.h),
# each in pieces under the 16 KB a string literal may have in MSVC. The build
# runs this again whenever one of the files changes, so the runtime the
# compiler writes into a file is runtime/go's as it is: there is no other
# copy of it to keep the same.
#
#   cmake -DDIR=runtime/go -DFILES=a.go,b.go -DOUT=goose_go_runtime.h -P go_runtime.cmake

string(REPLACE "," ";" files "${FILES}")
set(out "// Generated by cmake/go_runtime.cmake from runtime/go at the compiler's build. Do not edit.\n")
string(APPEND out "#pragma once\n\nnamespace goose {\n\n")
string(APPEND out "// A file of the Go runtime: its name in runtime/go, and its text, in parts.\n")
string(APPEND out "struct GoRuntimeFile {\n    const char *name;\n    const char *const *parts;\n    int nparts;\n};\n\n")
set(table "")
set(index 0)
foreach(name IN LISTS files)
    file(READ "${DIR}/${name}" text)
    string(FIND "${text}" ")GSGO\"" bad)
    if(NOT bad EQUAL -1)
        message(FATAL_ERROR "runtime/go/${name} holds the raw string literal's delimiter )GSGO\"")
    endif()
    string(LENGTH "${text}" length)
    set(pos 0)
    set(parts 0)
    string(APPEND out "inline const char *const go_runtime_file${index}[] = {\n")
    while(pos LESS length)
        math(EXPR rest "${length} - ${pos}")
        if(rest GREATER 8000)
            # Up to the last line break of the next 8000 bytes.
            string(SUBSTRING "${text}" ${pos} 8000 piece)
            string(FIND "${piece}" "\n" nl REVERSE)
            if(nl GREATER 0)
                math(EXPR cut "${nl} + 1")
                string(SUBSTRING "${piece}" 0 ${cut} piece)
            endif()
        else()
            string(SUBSTRING "${text}" ${pos} -1 piece)
        endif()
        string(LENGTH "${piece}" plen)
        math(EXPR pos "${pos} + ${plen}")
        string(APPEND out "R\"GSGO(${piece})GSGO\",\n")
        math(EXPR parts "${parts} + 1")
    endwhile()
    string(APPEND out "};\n\n")
    string(APPEND table "    { \"${name}\", go_runtime_file${index}, ${parts} },\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND out "inline const GoRuntimeFile go_runtime_files[] = {\n${table}};\n\n}  // namespace goose\n")
# Rewritten only where it changes, so that an unchanged runtime rebuilds
# nothing.
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL out)
    file(WRITE "${OUT}" "${out}")
endif()
